---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Aidil Pramadita Putra — Creative Developer",
  description = "Aidil Pramadita Putra — Digital Product Engineer. Portfolio creative developer: frontend engineering, UI/UX design, motion, dan branding.",
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F5F3EA" />
    <meta property="og:title" content="Aidil Pramadita Putra — Creative Developer" />
    <meta
      property="og:description"
      content="Piksel, kode, dan sedikit kekacauan. Portfolio Digital Product Engineer."
    />
    <meta property="og:type" content="website" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%232B2FF0%22/><text x=%2250%22 y=%2268%22 font-size=%2260%22 text-anchor=%22middle%22 fill=%22%23F5F3EA%22 font-family=%22sans-serif%22 font-weight=%22bold%22>A</text></svg>"
    />
    <title>{title}</title>

    <script is:inline>
      // Terapkan tema tersimpan sebelum render agar tidak "kedip" (FOUC)
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)"
          ).matches;
          var theme = saved || (prefersDark ? "dark" : "light");
          if (theme === "dark")
            document.documentElement.setAttribute("data-theme", "dark");
        } catch (e) {}
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="overflow-x-hidden">
    <noscript
      ><style>
        #loader {
          display: none !important;
        }
        #main-content {
          opacity: 1 !important;
        }
      </style></noscript
    >

    <a
      href="#main-content"
      class="skip-link hard-sm bg-[var(--lime)] px-4 py-2 mono text-xs font-bold"
      >Lewati ke konten →</a
    >

    <slot />
  </body>
</html>
