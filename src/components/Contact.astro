---
import { initialComments } from "../data/comments";
---

<section id="contact" class="py-20 px-6 max-w-6xl mx-auto reveal">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
    <div class="lg:col-span-5 space-y-6">
      <div>
        <span class="mono text-xs font-bold text-[var(--coral)] tracking-widest">05 / KOLABORASI</span>
        <h2 class="display text-3xl sm:text-4xl mt-2">HUBUNGI SAYA</h2>
        <p class="text-xs text-[var(--ink)]/70 mt-3 leading-relaxed">
          Punya ide menarik? Mari diskusikan atau sapa saya di saluran berikut.
        </p>
      </div>
      <div class="space-y-3">
        <a
          href="https://www.linkedin.com/in/aidilprmdta"
          target="_blank"
          rel="noopener noreferrer"
          class="cursor-hover hard-sm flex items-center justify-between p-4 bg-[var(--lime)] font-bold"
        >
          <span class="mono text-xs">LINKEDIN</span><span class="text-xs">→</span>
        </a>
        <a
          href="https://github.com/aidilprmdta"
          target="_blank"
          rel="noopener noreferrer"
          class="cursor-hover hard-sm flex items-center justify-between p-4 bg-[var(--coral)] text-white font-bold"
        >
          <span class="mono text-xs">GITHUB</span><span class="text-xs">→</span>
        </a>
        <a
          href="https://instagram.com/aidilprmdta"
          target="_blank"
          rel="noopener noreferrer"
          class="cursor-hover hard-sm flex items-center justify-between p-4 bg-[var(--pink)] text-white font-bold"
        >
          <span class="mono text-xs">INSTAGRAM</span><span class="text-xs">→</span>
        </a>
        <a
          href="https://www.youtube.com/c/AidilTipi"
          target="_blank"
          rel="noopener noreferrer"
          class="cursor-hover hard-sm w-full flex items-center justify-between p-4 bg-[var(--red)] text-white font-bold text-left"
        >
          <span class="mono text-xs">YOUTUBE</span><span class="text-xs">→</span>
        </a>
        <button
          id="copyEmailBtn"
          class="cursor-hover hard-sm w-full flex items-center justify-between p-4 bg-[var(--card)] font-bold text-left"
        >
          <span class="mono text-xs">EMAIL</span>
          <span class="mono text-[10px] text-[var(--ink)]/60">pramadytaa@gmail.com · salin</span>
        </button>
      </div>
    </div>

    <div class="lg:col-span-7 hard bg-[var(--card)] p-6 sm:p-8">
      <div class="flex items-center justify-between mb-6">
        <h3 class="display text-sm flex items-center gap-2">
          <span>💬</span> Guestbook / Komentar
        </h3>
        <span id="supabaseStatus" class="mono text-[10px] px-2 py-0.5 hard-sm bg-[var(--paper)] text-[var(--ink)]/60">
          ⚡ Supabase Connected
        </span>
      </div>

      <form id="commentForm" class="space-y-4 mb-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <input
            type="text"
            id="commenterName"
            placeholder="Nama Anda"
            aria-label="Nama Anda"
            class="hard-sm px-4 py-2.5 bg-[var(--paper)] text-xs"
            required
          />
          <input
            type="text"
            id="commenterRole"
            placeholder="Jabatan/Instansi"
            aria-label="Jabatan atau Instansi"
            class="hard-sm px-4 py-2.5 bg-[var(--paper)] text-xs"
            required
          />
        </div>
        <textarea
          id="commenterText"
          rows="3"
          placeholder="Tinggalkan pesan di sini..."
          aria-label="Pesan"
          class="hard-sm w-full px-4 py-2.5 bg-[var(--paper)] text-xs resize-none"
          required></textarea>
        <button
          id="submitCommentBtn"
          type="submit"
          class="cursor-hover hard hard-btn w-full py-2.5 bg-[var(--ink)] text-[var(--paper)] font-bold text-xs flex items-center justify-center gap-2"
        >
          <span>KIRIM PESAN</span>
        </button>
      </form>

      <div id="commentsContainer" class="space-y-3 max-h-60 overflow-y-auto pr-1">
        {
          initialComments.map((c) => (
            <div class="hard-sm p-3 bg-[var(--paper)]">
              <div class="flex justify-between items-center mb-1">
                <h4 class="text-xs font-bold">{c.name}</h4>
                <span class="mono text-[9px] text-[var(--ink)]/50">{c.role}</span>
              </div>
              <p class="text-[11px] text-[var(--ink)]/70">"{c.text}"</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { fetchCommentsFromSupabase, postCommentToSupabase, isSupabaseConfigured } from "../lib/supabase";
  import type { Comment } from "../data/comments";

  function renderCommentCard(comment: Comment, isHighlight = false): HTMLElement {
    const card = document.createElement("div");
    card.className = isHighlight
      ? "hard-sm p-3 bg-[var(--lime)] transform translate-y-2 opacity-0 transition-all duration-500"
      : "hard-sm p-3 bg-[var(--paper)]";

    const row = document.createElement("div");
    row.className = "flex justify-between items-center mb-1";
    
    const h4 = document.createElement("h4");
    h4.className = "text-xs font-bold";
    h4.textContent = comment.name;

    const span = document.createElement("span");
    span.className = "mono text-[9px] text-[var(--ink)]/50";
    span.textContent = comment.role;

    row.append(h4, span);

    const p = document.createElement("p");
    p.className = "text-[11px] text-[var(--ink)]/70";
    p.textContent = `"${comment.text}"`;

    card.append(row, p);
    return card;
  }

  // Guestbook Logic
  async function initGuestbook() {
    const commentForm = document.getElementById("commentForm") as HTMLFormElement;
    const commentsContainer = document.getElementById("commentsContainer")!;
    const submitBtn = document.getElementById("submitCommentBtn") as HTMLButtonElement;
    const statusBadge = document.getElementById("supabaseStatus")!;

    const hasSupabase = isSupabaseConfigured();

    if (!hasSupabase) {
      statusBadge.textContent = "⚙️ Supabase: Mode Lokal (.env belum diisi)";
      statusBadge.className = "mono text-[9px] px-2 py-0.5 hard-sm bg-[var(--paper)] text-amber-600 font-semibold";
    } else {
      statusBadge.textContent = "⚡ Supabase Active";
      statusBadge.className = "mono text-[9px] px-2 py-0.5 hard-sm bg-[var(--lime)] text-[var(--ink)] font-bold";

      // Load comments from Supabase
      const { data, error } = await fetchCommentsFromSupabase();
      if (error) {
        statusBadge.textContent = "⚠️ Supabase Connected (Belum ada tabel SQL)";
        statusBadge.className = "mono text-[9px] px-2 py-0.5 hard-sm bg-amber-200 text-amber-900 font-bold";
      } else if (data && data.length > 0) {
        commentsContainer.innerHTML = "";
        data.forEach((c) => {
          commentsContainer.appendChild(renderCommentCard(c));
        });
      }
    }

    commentForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const nameEl = document.getElementById("commenterName") as HTMLInputElement;
      const roleEl = document.getElementById("commenterRole") as HTMLInputElement;
      const textEl = document.getElementById("commenterText") as HTMLTextAreaElement;

      const name = nameEl.value.trim();
      const role = roleEl.value.trim();
      const text = textEl.value.trim();
      if (!name || !role || !text) return;

      submitBtn.disabled = true;
      const originalBtnText = submitBtn.innerHTML;
      submitBtn.innerHTML = `<span>MENGIRIM...</span>`;

      try {
        if (isSupabaseConfigured()) {
          const { data, error } = await postCommentToSupabase({ name, role, text });

          if (error) {
            (window as any).showToast?.("Gagal menyimpan ke Supabase: " + (error.message || "Error"), "⚠️");
          } else if (data) {
            const card = renderCommentCard(data, true);
            commentsContainer.insertBefore(card, commentsContainer.firstChild);
            setTimeout(() => card.classList.remove("translate-y-2", "opacity-0"), 50);
            commentForm.reset();
            (window as any).showToast?.("Komentar berhasil disimpan ke Supabase! 💬", "⚡");
          }
        } else {
          // Fallback lokal jika belum dikonfigurasikan
          const newComment: Comment = { name, role, text };
          const card = renderCommentCard(newComment, true);
          commentsContainer.insertBefore(card, commentsContainer.firstChild);
          setTimeout(() => card.classList.remove("translate-y-2", "opacity-0"), 50);
          commentForm.reset();
          (window as any).showToast?.("Pesan dikirim (Mode Lokal). Konfigurasikan Supabase di .env 💬", "💬");
        }
      } catch (err: any) {
        (window as any).showToast?.("Terjadi kesalahan saat mengirim pesan", "⚠️");
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnText;
      }
    });
  }

  // Copy email logic
  function initCopyEmail() {
    const copyEmailBtn = document.getElementById("copyEmailBtn")!;
    copyEmailBtn.addEventListener("click", () => {
      const email = "pramadytaa@gmail.com";
      navigator.clipboard
        ?.writeText(email)
        .then(() => {
          (window as any).showToast?.("Email disalin ke clipboard", "📋");
        })
        .catch(() =>
          (window as any).showToast?.("Gagal menyalin, salin manual: " + email, "⚠️")
        );
    });
  }

  initGuestbook();
  initCopyEmail();
</script>
