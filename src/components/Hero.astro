---
import Marquee from "./Marquee.astro";
---

<section id="home" class="relative px-6 pt-16 pb-24 max-w-6xl mx-auto">
  <div class="absolute -top-6 -right-4 sm:right-10 stamp2">
    <div class="hard-sm bg-[var(--lime)] px-12 py-3 mt-9 mono text-[10px] font-bold">
      <span
        class="inline-block w-2 h-2 rounded-full bg-[var(--ink)] animate-ping align-middle mr-1"
      ></span>
      STATUS: OPEN
    </div>
  </div>

  <span class="mono text-xs font-bold tracking-[0.3em] text-[var(--blue)]"
    >DIGITAL PRODUCT DEVELOPER</span
  >

  <h1 class="display text-[13vw] sm:text-6xl md:text-7xl leading-[0.95] mt-4 tracking-tight">
    KODE, DESAIN, &<br />
    & SEDIKIT <span class="relative inline-block">
      <span class="relative z-10">PRODUK YANG BERGUNA.</span>
      <span
        class="absolute inset-x-0 bottom-1 h-4 sm:h-5 bg-[var(--lime)] -z-0 -rotate-1"
      ></span>
    </span>
  </h1>

  <div class="grid sm:grid-cols-3 gap-6 mt-10 items-end">
    <p class="sm:col-span-2 text-sm sm:text-base text-[var(--ink)]/80 leading-relaxed max-w-xl">
      Halo, saya Aidil — mahasiswa Teknik Informatika yang membangun produk digital dari ide, desain, sampai implementasi.
      Saya fokus pada frontend development, UI/UX, dan eksplorasi teknologi baru untuk memecahkan masalah nyata.
    </p>
    <div class="flex sm:justify-end gap-3">
      <a
        href="#portfolio"
        class="cursor-hover hard hard-btn bg-[var(--blue)] text-[var(--paper)] px-5 py-3 mono text-xs font-bold whitespace-nowrap"
        >LIHAT KARYA →</a
      >
    </div>
  </div>

  <div
    class="inline-flex items-center gap-3 px-4 py-2 bg-[var(--ink)] mt-10 mono text-xs text-[var(--lime)]"
  >
    <span>$</span>
    <span>npx aidilprmdta --build --loud</span>
    <span class="w-1.5 h-4 bg-[var(--lime)] animate-pulse"></span>
  </div>
</section>

<Marquee
  items={["UI DESIGN", "FRONTEND DEV", "MOTION", "BRANDING"]}
  wrapClass="bg-[var(--blue)] text-[var(--paper)] py-3 border-y-[3px] border-[var(--ink)]"
  trackClass="rev display text-xl sm:text-2xl"
  itemClass="px-6"
  separator="✦"
/>
